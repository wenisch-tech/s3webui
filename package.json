{
  "name": "s3webui-frontend",
  "private": true,
  "scripts": {
    "build": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i src/main/frontend/s3webui.css -o target/classes/static/css/s3webui.css --minify && esbuild src/main/frontend/s3webui.js --bundle --minify --format=iife --outfile=target/classes/static/js/s3webui.js",
    "build:css": "node ./node_modules/@tailwindcss/cli/dist/index.mjs -i src/main/frontend/s3webui.css -o target/classes/static/css/s3webui.css --minify",
    "build:js": "esbuild src/main/frontend/s3webui.js --bundle --minify --format=iife --outfile=target/classes/static/js/s3webui.js"
  },
  "dependencies": {
    "alpinejs": "3.14.9",
    "lucide": "0.468.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "esbuild": "0.25.12",
    "tailwindcss": "4.3.3"
  }
}
