# Maintainer: Jean-Fabian Wenisch <jean-fabian@wenisch.tech>
#
# Wraps the jpackage app-image (bundled JRE + JavaFX) into a pacman package.
# Build the image first:  mvn -Pdesktop,desktop-package,desktop-linux-image -DskipTests pre-integration-test
# Then:                   makepkg -f      (or use packaging/build-linux.sh)

pkgname=s3webui
pkgver=${S3WEBUI_VERSION:-1.0.0}
pkgrel=1
pkgdesc='Desktop edition of S3 Web UI - graphical interface for S3 object storage'
arch=('x86_64')
url='https://github.com/wenisch-tech/s3webui'
license=('AGPL-3.0-only')
depends=('gtk3' 'glib2' 'cairo' 'pango' 'fontconfig' 'freetype2' 'libxtst' 'libxxf86vm' 'alsa-lib' 'mesa')
# the bundled JRE and JavaFX natives must stay untouched
options=('!strip' '!debug')
_dist="$startdir/../../target/dist/S3WEBUI"

package() {
  install -d "$pkgdir/opt/$pkgname" "$pkgdir/usr/bin"
  cp -a "$_dist/." "$pkgdir/opt/$pkgname/"
  ln -s "/opt/$pkgname/bin/S3WEBUI" "$pkgdir/usr/bin/$pkgname"

  install -Dm644 "$startdir/s3webui.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
  install -Dm644 "$startdir/../icons/s3webui.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"
  install -Dm644 "$startdir/../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
